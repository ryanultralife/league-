# Diamond Overlay environment configuration.
# Copy to `.env.local` for local dev, or set these in the Vercel dashboard.
# All are optional — with none set, the app runs in single-device "local" sync
# mode using BroadcastChannel/localStorage.

# --- Realtime sync (Supabase) ---
# When both are set, devices sync in real time over Supabase Realtime broadcast,
# which works across networks (the master phone and the video phone can be on
# different Wi-Fi / a hotspot). Find these in Supabase → Project Settings → API.
# No tables/SQL are required to go live; the live path uses broadcast.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The game "room". Every device sharing this value joins the same game, so keep
# it identical across all phones (they inherit it from the shared Vercel env).
# Change it only to run two separate games at once.
NEXT_PUBLIC_GAME_ROOM=default-game

# --- Live streaming ---
# The WHIP ingest URL + token are entered in the /stream UI at go-live time,
# so nothing is required here. For Livepeer, the WHIP URL is:
#   https://livepeer.studio/webrtc/<STREAM-KEY>     (token left blank)
# Providers with WHIP browser ingest:
#   Livepeer:   https://livepeer.studio  (free tier)
#   Mux:        https://www.mux.com       (trial credit)
#   Cloudflare: https://developers.cloudflare.com/stream/webrtc-beta/

# Default Livepeer playback ID for the branded /watch page. Viewers can also
# override per-visit with /watch?v=<playbackId>.
NEXT_PUBLIC_LIVEPEER_PLAYBACK_ID=
